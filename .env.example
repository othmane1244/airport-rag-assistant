# Copy to .env before `docker compose up --build` and replace these values.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-unique-password
KEYCLOAK_DB_PASSWORD=replace-with-another-long-unique-password

# Optional: host folder holding the HuggingFace model cache (BGE-M3), mounted read-only in the rag container.
# HF_CACHE_DIR=C:/Users/<you>/.cache/huggingface/hub
