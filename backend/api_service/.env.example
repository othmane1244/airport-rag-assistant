ENVIRONMENT=development
RAG_SERVICE_URL=http://127.0.0.1:8002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AERODATABOX_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
REDIS_URL=redis://localhost:6379/0

# Keycloak issuer must match the `iss` claim in browser-issued access tokens.
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/aga-airport
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/aga-airport/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=aga-api

# Development only: skips JWT validation when ENVIRONMENT=development. Never enable in production.
AUTH_DISABLED=false
